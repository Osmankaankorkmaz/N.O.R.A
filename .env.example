# Copy values into your shell environment. Nora does NOT auto-load .env files.
# Never commit a real key.
GROQ_API_KEY=

# Optional model overrides (defaults shown).
NORA_CHAT_MODEL=llama-3.3-70b-versatile
# The document's llama-3.2-90b-vision-preview is retired. Current official default:
NORA_VISION_MODEL=qwen/qwen3.8-27b

# Privacy / behaviour switches: 1=true, 0=false.
NORA_WAKE_WORD=1
NORA_TTS=1
NORA_PROACTIVE=1
NORA_OFFLINE=0

# Dangerous convenience: arbitrary Python runs with YOUR user permissions.
# Keep 0 unless you understand the risk. Every execution still asks for consent.
NORA_ALLOW_CODE=0
NORA_LOG_LEVEL=INFO
